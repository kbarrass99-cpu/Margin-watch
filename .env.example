# Supabase project settings (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email alerts) - resend.com, free tier
RESEND_API_KEY=
ALERT_FROM_EMAIL=onboarding@resend.dev

# A long random password you make up yourself.
# This protects the /api/cron/check-all endpoint so only your scheduler can call it.
CRON_SECRET=choose-a-long-random-secret-here

# Optional - firecrawl.dev, free tier to start. Used as a fallback when a
# supplier blocks the plain scraper. Leave blank and
# the scraper just skips the fallback - it won't break anything.
FIRECRAWL_API_KEY=

# AliExpress blocks automated page visits, so AliExpress links are read
# through the official AliExpress Affiliate API (openservice.aliexpress.com).
# Without these, AliExpress products can't be tracked.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional: your affiliate tracking ID from portals.aliexpress.com
ALIEXPRESS_TRACKING_ID=

# Stripe billing (dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices are found by lookup key (starter_monthly_usd, starter_yearly_usd,
# pro_monthly_usd, pro_yearly_usd), so no price IDs are needed here. These two
# are an optional fallback for recognising a subscription's plan.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# Your live site URL, no trailing slash - e.g. https://margincanary.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional - sentry.io. Captures scraper and API failures server-side so
# they show up somewhere instead of vanishing. Leave blank and nothing
# changes - Sentry is simply disabled.
SENTRY_DSN=
