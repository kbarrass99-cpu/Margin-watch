# Supabase project settings (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email alerts) - resend.com, free tier
RESEND_API_KEY=
ALERT_FROM_EMAIL=onboarding@resend.dev

# A long random password you make up yourself.
# This protects the /api/cron/check-all endpoint so only your scheduler can call it.
CRON_SECRET=choose-a-long-random-secret-here
